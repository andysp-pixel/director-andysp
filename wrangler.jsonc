{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "director-andysp",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/api/*", "/media/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "director-andy-db",
      "database_id": "3181de1d-4403-44be-8f8e-39d82fda5442"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "director-andy-media"
    }
  ],
  "send_email": [
    {
      "name": "BOOKING_EMAIL",
      "destination_address": "damoryandy@gmail.com"
    }
  ],
  "observability": { "enabled": true }
}
